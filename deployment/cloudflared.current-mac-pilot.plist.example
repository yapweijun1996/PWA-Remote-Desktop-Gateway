<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.rdg.current-mac-pilot.cloudflared</string>
	<key>ProgramArguments</key>
	<array>
		<string>__CLOUDFLARED_BINARY__</string>
		<string>tunnel</string>
		<string>--config</string>
		<string>__PRIVATE_PILOT_DIRECTORY__/tunnel.yml</string>
		<string>--no-autoupdate</string>
		<string>--metrics</string>
		<string>127.0.0.1:32124</string>
		<string>--loglevel</string>
		<string>error</string>
		<string>--transport-loglevel</string>
		<string>error</string>
		<string>run</string>
		<string>__TUNNEL_ID__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>WorkingDirectory</key>
	<string>__PRIVATE_PILOT_DIRECTORY__</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
</dict>
</plist>
