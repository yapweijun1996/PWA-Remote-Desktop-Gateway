# PLACEHOLDERS ONLY. Never commit a populated .env or copy secrets into it.
RDG_NODE_ID=node-mini
RDG_PUBLIC_ORIGIN=https://remote-mini.example.com
RDG_ACCESS_ISSUER=https://REPLACE-TEAM.cloudflareaccess.com
RDG_ACCESS_AUDIENCE=REPLACE-APP-AUDIENCE
RDG_OWNER_EMAIL=REPLACE-EXACT-OWNER-EMAIL
GATEWAY_IMAGE=REPLACE-WITH-BUILT-IMAGE-AND-SHA256-DIGEST
GUACD_IMAGE=REPLACE-WITH-VERIFIED-IMAGE-AND-SHA256-DIGEST
RDG_DEVICE_CONFIG=/REPLACE/approved/device.mini.json
RDG_VNC_SECRET_PATH=/REPLACE/protected/rdg-vnc-password

# Default FULL requires the credential and six calibrated modifier keysyms.
# compose.blocked-pilot.yaml forces BLOCKED and does not consume VNC/GUACD fields.
RDG_DESKTOP_POLICY=FULL
